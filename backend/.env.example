# URL do banco em formato ASYNC (driver asyncpg) — usado pelo app FastAPI.
# O Alembic deriva a URL síncrona (psycopg) a partir desta.
# Local (container/dev): Postgres com auth trust.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/vocabkids

# dev | prod — guia min-instances/cold start etc. (seção 12 do produto)
APP_ENV=dev

# Segredo do JWT (HS256) — OBRIGATÓRIO. Gere o seu: `openssl rand -hex 32`.
# Nunca commitar o valor real; trocar o segredo invalida todas as sessões.
JWT_SECRET=

# TTL da sessão em horas (default 720 = 30 dias; ver app/config.py)
# JWT_TTL_HORAS=720

# Origens permitidas no CORS, separadas por vírgula (nunca "*").
# Vazio = CORS desligado (apps mobile não precisam; o site do professor precisa).
# CORS_ORIGINS=http://localhost:8080

# Rate limiting (janela de 60s, em memória). Defaults em app/config.py.
# RATE_LIMIT_HABILITADO=true
# RL_LOGIN_POR_MINUTO=20
# RL_ANONIMO_POR_MINUTO=60
# RL_AUTENTICADO_POR_MINUTO=240
